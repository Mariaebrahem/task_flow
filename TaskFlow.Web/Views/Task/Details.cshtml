@using TaskFlow.Services.Tasks.Comments
@using TaskFlow.Services.Tasks.Checklists
@using TaskFlow.Services.Tasks.Subtasks

@model TaskFlow.Services.Tasks.Models.TaskDetails
@using TaskFlow.Services.Tasks.Assignments.Models

@{
    ViewData["Title"] = "Task Details";
}

<div class="container mt-4">
    @await Component.InvokeAsync("Breadcrumbs", new { boardColumnId = Model.BoardColumnId, current = Model.Title })

 
    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Task Details</h4>

            <div class="d-flex gap-2">
                @if (Model.CanEdit)
                {
                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary btn-sm">
                        Edit Task
                    </a>
                }

                <a asp-action="Index"
                   asp-route-boardColumnId="@Model.BoardColumnId"
                   class="btn btn-outline-secondary btn-sm">
                    Back to Tasks
                </a>
            </div>
        </div>

        <div class="card-body">

            @* Success and Error Messages *@
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }

            @* Task Information *@
            <h3>@Model.Title</h3>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">
                    @(string.IsNullOrWhiteSpace(Model.Description)
                        ? "No description provided"
                        : Model.Description)
                </dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">@Model.Priority</dd>

                <dt class="col-sm-3">Board Column</dt>
                <dd class="col-sm-9">@Model.ColumnName</dd>

                <dt class="col-sm-3">Start Date</dt>
                <dd class="col-sm-9">
                    @(Model.StartDate?.ToShortDateString() ?? "Not specified")
                </dd>

                <dt class="col-sm-3">Due Date</dt>
                <dd class="col-sm-9">
                    @(Model.DueDate?.ToShortDateString() ?? "Not specified")
                </dd>

                <dt class="col-sm-3">Estimated Duration</dt>
                <dd class="col-sm-9">
                    @(Model.EstimatedMinutes.HasValue
                        ? $"{Model.EstimatedMinutes} minutes"
                        : "Not specified")
                </dd>

                <dt class="col-sm-3">Position</dt>
                <dd class="col-sm-9">@Model.Position</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToLocalTime().ToString("g")
                </dd>

                <dt class="col-sm-3">Last Updated</dt>
                <dd class="col-sm-9">
                    @(Model.UpdatedAt?.ToLocalTime().ToString("g") ?? "Never")
                </dd>

                <dt class="col-sm-3">Completion</dt>
                <dd class="col-sm-9">
                    @if (Model.IsCompleted)
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Completed</span>
                    }
                </dd>

                <dt class="col-sm-3">Archived</dt>
                <dd class="col-sm-9">
                    @(Model.IsArchived ? "Yes" : "No")
                </dd>

            </dl>

            @if (Model.CompletedAt.HasValue)
            {
                <p class="text-muted">
                    Completed on:
                    @Model.CompletedAt.Value.ToLocalTime().ToString("g")
                </p>
            }

            @* Task Assignments *@
            @{
                var assignments =
                    ViewBag.AssignmentDetails as TaskAssignmentDetails;
            }

            @if (assignments != null)
            {
                <hr />

                <h4>Task Assignments</h4>

                @if (assignments.Members.Count == 0)
                {
                    <p>No eligible project members are available.</p>
                }
                else if (assignments.CanManageAssignments)
                {
                    <form asp-controller="Task"
                          asp-action="UpdateAssignees"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="TaskId"
                               value="@assignments.TaskId" />

                        <p>Select the members assigned to this task:</p>

                        @foreach (var member in assignments.Members)
                        {
                            <div class="form-check mb-2">

                                <input class="form-check-input"
                                       type="checkbox"
                                       name="SelectedUserIds"
                                       value="@member.UserId"
                                       id="member_@member.UserId"
                                       checked="@member.IsAssigned" />

                                <label class="form-check-label"
                                       for="member_@member.UserId">

                                    @member.DisplayName

                                    @if (!string.IsNullOrEmpty(member.Email))
                                    {
                                        <small class="text-muted">
                                            (@member.Email)
                                        </small>
                                    }

                                </label>
                            </div>
                        }

                        <button type="submit"
                                class="btn btn-primary mt-2">
                            Save Assignments
                        </button>

                    </form>
                }
                else
                {
                    <h6>Assigned Members</h6>

                    <ul>
                        @foreach (var member in assignments.Members.Where(m => m.IsAssigned))
                        {
                            <li>@member.DisplayName</li>
                        }
                    </ul>
                }
            }

        </div>
    </div>


    @{
        var checklist = ViewBag.Checklist as ChecklistDetails;
    }

    @if (checklist != null)
    {
        <div class="card shadow-sm mt-4" id="checklist">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Checklist</h5>
                <span class="badge bg-secondary">@checklist.Done / @checklist.Total</span>
            </div>

            <div class="card-body">

                @if (checklist.Total > 0)
                {
                    <div class="progress mb-3" role="progressbar"
                         aria-label="Checklist progress"
                         aria-valuenow="@checklist.Percent" aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar" style="width: @(checklist.Percent)%">
                            @checklist.Percent%
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted">No checklist items yet.</p>
                }

                @foreach (var item in checklist.Items)
                {
                    <div class="d-flex align-items-center gap-2 mb-2">

                        @if (checklist.CanTick)
                        {
                            <form asp-controller="TaskChecklist" asp-action="Toggle" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <button type="submit" class="btn btn-sm btn-link p-0"
                                        aria-label="@(item.IsCompleted ? "Mark as not done" : "Mark as done")">
                                    <i class="bi @(item.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <i class="bi @(item.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")"></i>
                        }

                        <span class="flex-grow-1 @(item.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                            @item.Title
                        </span>

                        @if (checklist.CanEditStructure)
                        {
                            <form asp-controller="TaskChecklist" asp-action="Move" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <input type="hidden" name="direction" value="-1" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit"
                                        aria-label="Move up">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                            </form>

                            <form asp-controller="TaskChecklist" asp-action="Move" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <input type="hidden" name="direction" value="1" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit"
                                        aria-label="Move down">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </form>

                            <button class="btn btn-sm btn-outline-primary" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#rename-@item.Id">
                                Rename
                            </button>

                            <form asp-controller="TaskChecklist" asp-action="Remove" method="post"
                                  onsubmit="return confirm('Remove this item?');">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                            </form>
                        }
                    </div>

                    @if (checklist.CanEditStructure)
                    {
                        <div class="collapse mb-2" id="rename-@item.Id">
                            <form asp-controller="TaskChecklist" asp-action="Rename" method="post"
                                  class="d-flex gap-2">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <label class="visually-hidden" for="title-@item.Id">Item title</label>
                                <input id="title-@item.Id" name="title" class="form-control form-control-sm"
                                       maxlength="300" required value="@item.Title" />
                                <button class="btn btn-sm btn-primary" type="submit">Save</button>
                            </form>
                        </div>
                    }
                }

                @if (checklist.CanEditStructure)
                {
                    <hr />
                    <form asp-controller="TaskChecklist" asp-action="Add" method="post"
                          class="d-flex gap-2">
                        <input type="hidden" name="taskId" value="@Model.Id" />
                        <label class="visually-hidden" for="newItem">New checklist item</label>
                        <input id="newItem" name="title" class="form-control"
                               maxlength="300" required placeholder="Add an item..." />
                        <button class="btn btn-primary" type="submit">Add</button>
                    </form>
                }
            </div>
        </div>
    }

    @{
        var subtasks = ViewBag.Subtasks as SubtaskList;
    }

    @if (subtasks != null)
    {
        <div class="card shadow-sm mt-4" id="subtasks">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Subtasks</h5>
                <span class="badge bg-secondary">@subtasks.Done / @subtasks.Total</span>
            </div>

            <div class="card-body">

                @if (subtasks.AllDone)
                {
                    <div class="alert alert-info py-2">
                        All subtasks are done. The task itself is not completed automatically.
                    </div>
                }

                @if (subtasks.Total == 0)
                {
                    <p class="text-muted">No subtasks yet.</p>
                }

                @foreach (var sub in subtasks.Items)
                {
                    <div class="d-flex align-items-start gap-2 mb-2">

                        @if (subtasks.CanTick)
                        {
                            <form asp-controller="TaskSubtask" asp-action="Toggle" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="subtaskId" value="@sub.Id" />
                                <button type="submit" class="btn btn-sm btn-link p-0"
                                        aria-label="@(sub.IsCompleted ? "Mark as not done" : "Mark as done")">
                                    <i class="bi @(sub.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <i class="bi @(sub.IsCompleted ? "bi-check-square-fill text-success" : "bi-square")"></i>
                        }

                        <div class="flex-grow-1">
                            <div class="@(sub.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                @sub.Title
                            </div>
                            @if (!string.IsNullOrWhiteSpace(sub.Description))
                            {
                                <small class="text-muted d-block">@sub.Description</small>
                            }
                            @if (sub.DueDate.HasValue)
                            {
                                <small class="text-muted">
                                    <i class="bi bi-calendar-event"></i>
                                    Due: @sub.DueDate.Value.ToShortDateString()
                                </small>
                            }
                        </div>

                        @if (subtasks.CanEditStructure)
                        {
                            <form asp-controller="TaskSubtask" asp-action="Move" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="subtaskId" value="@sub.Id" />
                                <input type="hidden" name="direction" value="-1" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit"
                                        aria-label="Move up">
                                    <i class="bi bi-arrow-up"></i>
                                </button>
                            </form>

                            <form asp-controller="TaskSubtask" asp-action="Move" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="subtaskId" value="@sub.Id" />
                                <input type="hidden" name="direction" value="1" />
                                <button class="btn btn-sm btn-outline-secondary" type="submit"
                                        aria-label="Move down">
                                    <i class="bi bi-arrow-down"></i>
                                </button>
                            </form>

                            <button class="btn btn-sm btn-outline-primary" type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#sub-edit-@sub.Id">
                                Edit
                            </button>

                            <form asp-controller="TaskSubtask" asp-action="Remove" method="post"
                                  onsubmit="return confirm('Remove this subtask?');">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="subtaskId" value="@sub.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                            </form>
                        }
                    </div>

                    @if (subtasks.CanEditStructure)
                    {
                        <div class="collapse mb-3" id="sub-edit-@sub.Id">
                            <form asp-controller="TaskSubtask" asp-action="Edit" method="post">
                                <input type="hidden" name="taskId" value="@Model.Id" />
                                <input type="hidden" name="subtaskId" value="@sub.Id" />

                                <label class="form-label" for="sub-title-@sub.Id">Title</label>
                                <input id="sub-title-@sub.Id" name="title" class="form-control form-control-sm mb-2"
                                       maxlength="200" required value="@sub.Title" />

                                <label class="form-label" for="sub-desc-@sub.Id">Description</label>
                                <textarea id="sub-desc-@sub.Id" name="description"
                                          class="form-control form-control-sm mb-2"
                                          rows="2" maxlength="2000">@sub.Description</textarea>

                                <label class="form-label" for="sub-due-@sub.Id">Due date</label>
                                <input id="sub-due-@sub.Id" name="dueDate" type="date"
                                       class="form-control form-control-sm mb-2"
                                       value="@(sub.DueDate?.ToString("yyyy-MM-dd"))" />

                                <button class="btn btn-sm btn-primary" type="submit">Save</button>
                            </form>
                        </div>
                    }
                }

                @if (subtasks.CanEditStructure)
                {
                    <hr />
                    <form asp-controller="TaskSubtask" asp-action="Add" method="post">
                        <input type="hidden" name="taskId" value="@Model.Id" />

                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="visually-hidden" for="newSubTitle">Subtask title</label>
                                <input id="newSubTitle" name="title" class="form-control"
                                       maxlength="200" required placeholder="Subtask title" />
                            </div>
                            <div class="col-md-4">
                                <label class="visually-hidden" for="newSubDesc">Description</label>
                                <input id="newSubDesc" name="description" class="form-control"
                                       maxlength="2000" placeholder="Description (optional)" />
                            </div>
                            <div class="col-md-2">
                                <label class="visually-hidden" for="newSubDue">Due date</label>
                                <input id="newSubDue" name="dueDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-primary w-100" type="submit">Add</button>
                            </div>
                        </div>
                    </form>
                }
            </div>
        </div>
    }
    @{
        var comments = ViewBag.Comments as TaskCommentList;
    }

    @if (comments != null)
    {
        <div class="card shadow-sm mt-4" id="comments">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Comments</h5>
                <span class="badge bg-secondary">@comments.TotalCount</span>
            </div>

            <div class="card-body">

                @if (comments.HasOlder)
                {
                    <a class="btn btn-outline-secondary btn-sm mb-3"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       asp-route-commentPage="@(comments.Page + 1)"
                       fragment="comments">
                        Load older comments
                    </a>
                }

                @if (comments.Items.Count == 0)
                {
                    <p class="text-muted mb-0">No comments yet.</p>
                }

                @foreach (var c in comments.Items.Where(i => i.ParentCommentId == null))
                {
                    @await Html.PartialAsync("_Comment", (c, comments, Model.Id, false))

                    @foreach (var reply in comments.Items.Where(i => i.ParentCommentId == c.Id))
                    {
                        <div class="ms-4 border-start ps-3">
                            @await Html.PartialAsync("_Comment", (reply, comments, Model.Id, true))
                        </div>
                    }
                }

                @if (comments.CanComment)
                {
                    <hr />
                    <form asp-controller="TaskComment" asp-action="Add" method="post">
                        <input type="hidden" name="taskId" value="@Model.Id" />

                        <div class="mb-2">
                            <label for="newComment" class="form-label">Add a comment</label>
                            <textarea id="newComment" name="content" class="form-control"
                                      rows="3" maxlength="5000" required></textarea>
                            <div class="form-text">
                                Up to 5000 characters. Mention someone with @@their-email.
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-sm">Post comment</button>
                    </form>
                }
                else
                {
                    <p class="text-muted small mb-0 mt-3">
                        You have view-only access, so you cannot comment.
                    </p>
                }
            </div>
        </div>
    }
</div>

